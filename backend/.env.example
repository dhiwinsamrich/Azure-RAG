# Which provider serves generation, embeddings and the eval judge.
# Retrieval (Azure AI Search), parsing (Document Intelligence) and storage
# stay on Azure either way.
LLM_PROVIDER=gemini

# --- Gemini ----------------------------------------------------------------
# Local development reads the key from here. In Azure, leave this EMPTY and
# set KEY_VAULT_URI instead: the container app fetches the secret at runtime
# with its managed identity, so the key never sits in container config or an
# image layer.
GEMINI_API_KEY=your-gemini-api-key
# KEY_VAULT_URI=https://finrag-dev-kv.vault.azure.net/
# GEMINI_API_KEY_SECRET_NAME=gemini-api-key

GEMINI_CHAT_MODEL=gemini-3.8-flash
# The judge is deliberately a different, stronger, STABLE model. Self-grading
# inflates faithfulness, and a preview model's drift looks like a real quality
# change on the dashboard.
GEMINI_JUDGE_MODEL=gemini-2.5-pro
# gemini-embedding-001 returns one embedding PER input string.
# gemini-embedding-2 returns a single aggregated embedding for a list, which
# would silently corrupt a batch of chunks. The embedder rejects it.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Gemini supports 768 / 1536 / 3072. FIXED AT INDEX CREATION - changing this
# means creating a new index and re-embedding the corpus.
EMBED_DIMS=1536

# --- Azure services (endpoints only, never keys) ---------------------------
SEARCH_ENDPOINT=https://finrag-dev-search.search.windows.net
SEARCH_INDEX=filings
DOC_INTELLIGENCE_ENDPOINT=https://finrag-dev-docintel.cognitiveservices.azure.com/
STORAGE_ACCOUNT_URL=https://finragdevxxxxxx.blob.core.windows.net

# --- Azure OpenAI (only if LLM_PROVIDER=azure_openai) ----------------------
# OPENAI_ENDPOINT=https://finrag-dev-openai.openai.azure.com/
# OPENAI_API_VERSION=2024-10-21
# CHAT_DEPLOYMENT=gpt-4o-mini
# JUDGE_DEPLOYMENT=gpt-4.1
# EMBED_DEPLOYMENT=text-embedding-3-large

# SQLite locally; swap for the PostgreSQL URL in Azure.
DATABASE_URL=sqlite+pysqlite:///./azure_rag.db

DEFAULT_CONFIG_ID=hybrid_semantic
ONLINE_EVAL_SAMPLE_RATE=0.05
